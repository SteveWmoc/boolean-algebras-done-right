/-!
# Interval algebras

For a linear order `X`, the interval algebra is the algebra of subsets
generated by the strict initial segments `Set.Iio a`. Complements provide
final segments `Set.Ici a`, and intersections provide half-open intervals
`Set.Ico a b`. Initial and final segments account for unbounded ends.

The construction uses finite Boolean expressions. Every element is
determined by comparisons with finitely many endpoints. No endpoints,
density, or topology on the linear order are assumed.
-/

universe u

namespace BooleanAlgebrasDoneRight

namespace SetExamples

variable {X : Type u} [LinearOrder X]

/-- Membership in the algebra generated by strict initial segments. -/
inductive InIntervalAlgebra : Set X → Prop
  | empty : InIntervalAlgebra ∅
  | initial (a : X) : InIntervalAlgebra (Set.Iio a)
  | union {s t : Set X} :
      InIntervalAlgebra s → InIntervalAlgebra t → InIntervalAlgebra (s ∪ t)
  | compl {s : Set X} : InIntervalAlgebra s → InIntervalAlgebra sᶜ

namespace InIntervalAlgebra

theorem univ : InIntervalAlgebra (Set.univ : Set X) := by
  simpa using (empty (X := X)).compl

theorem inter {s t : Set X} (hs : InIntervalAlgebra s)
    (ht : InIntervalAlgebra t) : InIntervalAlgebra (s ∩ t) := by
  have h := (hs.compl.union ht.compl).compl
  have heq : (sᶜ ∪ tᶜ)ᶜ = s ∩ t := by
    ext x
    simp
  rw [heq] at h
  exact h

theorem final (a : X) : InIntervalAlgebra (Set.Ici a) := by
  simpa only [Set.compl_Iio] using (initial a).compl

theorem halfOpen (a b : X) : InIntervalAlgebra (Set.Ico a b) :=
  (final a).inter (initial b)

/-- Membership is determined by comparisons with finitely many endpoints. -/
theorem finite_endpoints {s : Set X} (hs : InIntervalAlgebra s) :
    ∃ t : Finset X, ∀ x y : X,
      (∀ a ∈ t, (x < a ↔ y < a)) → (x ∈ s ↔ y ∈ s) := by
  classical
  induction hs with
  | empty => exact ⟨∅, fun _ _ _ => Iff.rfl⟩
  | initial a =>
    refine ⟨{a}, ?_⟩
    intro x y h
    exact h a (by simp)
  | union _hs _ht ihs iht =>
    obtain ⟨p, hp⟩ := ihs
    obtain ⟨q, hq⟩ := iht
    refine ⟨p ∪ q, ?_⟩
    intro x y h
    exact or_congr
      (hp x y (fun a ha => h a (Finset.mem_union.mpr (Or.inl ha))))
      (hq x y (fun a ha => h a (Finset.mem_union.mpr (Or.inr ha))))
  | compl _hs ih =>
    obtain ⟨t, ht⟩ := ih
    exact ⟨t, fun x y h => not_congr (ht x y h)⟩

end InIntervalAlgebra

/-- The family of sets in the interval algebra. -/
def intervalFamily (X : Type u) [LinearOrder X] : Set (Set X) :=
  {s | InIntervalAlgebra s}

@[simp] theorem mem_intervalFamily (s : Set X) :
    s ∈ intervalFamily X ↔ InIntervalAlgebra s := Iff.rfl

/-- Finite Boolean combinations of initial intervals form an algebra of
subsets of the whole linear order. -/
theorem isSetAlgebra_intervalFamily (X : Type u) [LinearOrder X] :
    IsSetAlgebra (Set.univ : Set X) (intervalFamily X) where
  subset_mem := fun _ => Set.subset_univ _
  empty_mem := InIntervalAlgebra.empty
  space_mem := InIntervalAlgebra.univ
  inter_mem := fun hs ht => hs.inter ht
  union_mem := fun hs ht => hs.union ht
  compl_mem := by
    intro s hs
    have heq : (Set.univ : Set X) \ s = sᶜ := by
      ext x
      simp
    change InIntervalAlgebra ((Set.univ : Set X) \ s)
    rw [heq]
    exact hs.compl

/-- The interval algebra is the least algebra of subsets containing every
strict initial segment. -/
theorem intervalFamily_minimal (F : Set (Set X))
    (hF : IsSetAlgebra (Set.univ : Set X) F)
    (hinitial : ∀ a : X, Set.Iio a ∈ F) :
    intervalFamily X ⊆ F := by
  intro s hs
  induction hs with
  | empty => exact hF.empty_mem
  | initial a => exact hinitial a
  | union _hs _ht ihs iht => exact hF.union_mem ihs iht
  | @compl s _hs ih =>
    have h := hF.compl_mem ih
    have heq : (Set.univ : Set X) \ s = sᶜ := by
      ext x
      simp
    rw [heq] at h
    exact h

/-- The interval subalgebra of the power set algebra on a linear order. -/
def intervalSetAlgebra (X : Type u) [LinearOrder X] :
    SetAlgebra (Set.univ : Set X) :=
  SetAlgebra.ofFamily (intervalFamily X) (isSetAlgebra_intervalFamily X)

/-- The carrier of the interval Boolean algebra. -/
abbrev IntervalAlgebra (X : Type u) [LinearOrder X] : Type u :=
  intervalSetAlgebra X

/-- All Boolean identities are inherited from the power set algebra. -/
instance intervalBooleanAlgebra (X : Type u) [LinearOrder X] :
    BooleanAlgebra (IntervalAlgebra X) :=
  BooleanAlgebra.Subalgebra.booleanAlgebra (intervalSetAlgebra X)

@[simp] theorem mem_intervalSetAlgebra
    (s : PowerSetAlgebra (Set.univ : Set X)) :
    s ∈ intervalSetAlgebra X ↔ InIntervalAlgebra (s : Set X) := Iff.rfl

@[simp] theorem toFamily_intervalSetAlgebra :
    (intervalSetAlgebra X).toFamily = intervalFamily X :=
  SetAlgebra.toFamily_ofFamily _ _

theorem initial_mem_intervalFamily (a : X) :
    Set.Iio a ∈ intervalFamily X := InIntervalAlgebra.initial a

theorem final_mem_intervalFamily (a : X) :
    Set.Ici a ∈ intervalFamily X := InIntervalAlgebra.final a

theorem halfOpen_mem_intervalFamily (a b : X) :
    Set.Ico a b ∈ intervalFamily X := InIntervalAlgebra.halfOpen a b

end SetExamples

end BooleanAlgebrasDoneRight
